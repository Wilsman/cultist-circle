{
  "name": "cultist-circle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "changelog:preview": "node scripts/extract-notes.mjs --print",
    "changelog:write": "node scripts/extract-notes.mjs --write",
    "i18n:generate": "node scripts/generate-i18n.mjs",
    "predev": "bun run i18n:generate",
    "prebuild": "bun run i18n:generate",
    "prestart": "bun run i18n:generate",
    "prelint": "bun run i18n:generate",
    "pretest": "bun run i18n:generate",
    "dev": "bun run --parallel dev:app feedback:dev",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "feedback:dev": "wrangler dev --config cloudflare/feedback/wrangler.jsonc --port 8787",
    "feedback:types": "wrangler types cloudflare/feedback/worker-configuration.d.ts --config cloudflare/feedback/wrangler.jsonc",
    "feedback:types:check": "wrangler types cloudflare/feedback/worker-configuration.d.ts --config cloudflare/feedback/wrangler.jsonc --check",
    "feedback:deploy:dry": "wrangler deploy --config cloudflare/feedback/wrangler.jsonc --dry-run",
    "feedback:deploy": "wrangler deploy --config cloudflare/feedback/wrangler.jsonc",
    "benchmark:tarkov-api": "bun scripts/benchmark-tarkov-api.mjs",
    "add-recipe": "bun tools/add-recipe.ts",
    "review:fetch": "bun tools/recipe-review/fetch-pending.mjs",
    "review": "bun tools/recipe-review/fetch-pending.mjs --serve"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "1.2.5",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@types/compression": "^1.7.5",
    "@vercel/analytics": "^1.6.1",
    "bottleneck": "^2.19.5",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "compression": "^1.8.2",
    "cookie": "^1.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.5.0",
    "js-cookie": "^3.0.8",
    "json5": "^2.2.3",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.431.8",
    "posthog-node": "^5.52.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.11",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@radix-ui/react-slot": "1.2.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/cookie": "^0.6.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^1.8.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.2"
  }
}
