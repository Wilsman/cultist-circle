# .env.local
#tarko-market api key
API_KEY=""
#use local data
USE_LOCAL_DATA=true
#node environment
NODE_ENV=""
#posthog analytics
NEXT_PUBLIC_POSTHOG_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
#Tarkov.dev client-side data source (json is the default; graphql is rollback)
NEXT_PUBLIC_TARKOV_DATA_SOURCE="json"
#optional Tarkov.dev endpoint overrides
NEXT_PUBLIC_TARKOV_JSON_URL="https://json.tarkov.dev"
NEXT_PUBLIC_TARKOV_GRAPHQL_URL="https://api.tarkov.dev/graphql"
TARKOV_GRAPHQL_URL="https://api.tarkov.dev/graphql"
