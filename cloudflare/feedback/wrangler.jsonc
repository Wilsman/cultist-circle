{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cultist-circle-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cultist-circle-feedback",
      "database_id": "6f5ac674-1579-4974-bd6f-f7c83577b2b3",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "2026090301",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
